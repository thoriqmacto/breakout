APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Drive (durable cold storage for historical data artifacts).
# CLIENT_SECRET and REFRESH_TOKEN are credentials -- never commit real values.
# Google Drive OAuth -- personal Gmail account.
# A service account cannot be used: Google gives them no storage quota, so one
# can create folders in My Drive but never own a file in them.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional parent folder. Blank means the authenticated user's My Drive root.
GOOGLE_DRIVE_FOLDER_ID=

# Folder created/used under the parent.
GOOGLE_DRIVE_ROOT=breakout-data

# Mirror disk for the OHLCV seed CSVs. Empty = pure-local, no mirroring.
CSV_MIRROR_DISK=
CSV_MIRROR_PATH=seeds/historical

# Interpreter used for resources/python/*.py (get_stocks.py needs pandas and
# yfinance). On a Debian/Ubuntu server the system python3 cannot be used --
# PEP 668 marks it externally-managed and pip refuses to install into it -- so
# point this at a virtualenv built from resources/python/requirements.txt:
#   PYTHON_BIN=/var/www/breakout/apps/api/.venv/bin/python
PYTHON_BIN=python3
PYTHON_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=1209600
JWT_LEEWAY=0

STOCKBIT_BEARER=
STOCKBIT_EXODUS_BASE=https://exodus.stockbit.com
SB_TRANSACTION_TYPE=TRANSACTION_TYPE_NET
SB_MARKET_BOARD=MARKET_BOARD_REGULER
SB_INVESTOR_TYPE=INVESTOR_TYPE_ALL
SB_LIMIT=25
SB_HISTORICAL_PERIOD=HS_PERIOD_DAILY
# SB_HISTORICAL_LIMIT=
# SB_HISTORICAL_PAGE=
SB_SAVE_DISK=local
SB_SAVE_DIR=broker_summary
SB_WATCHLIST_ID=808507
SB_WATCHLIST_PAGE=1
SB_WATCHLIST_LIMIT=500
SB_WATCHLIST_NOCHART=1
SB_WATCHLIST_SETFINCOL=1
