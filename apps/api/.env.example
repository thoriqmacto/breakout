APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Drive (durable cold storage for historical data artifacts).
# Never commit the service-account JSON; storage/app/google/*.json is gitignored.
GOOGLE_DRIVE_KEY_FILE=storage/app/google/service-account.json
# Prefer a Shared Drive: a service account has no storage quota and so cannot own
# files in My Drive. It can still create folders there, which makes the failure
# look like a permissions problem when it is not.
GOOGLE_DRIVE_TEAM_DRIVE_ID=
# My Drive folder shared with the service account. Lower precedence, and only
# usable where the account never has to own a file.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ROOT=breakout-data

# Mirror disk for the OHLCV seed CSVs. Empty = pure-local, no mirroring.
CSV_MIRROR_DISK=
CSV_MIRROR_PATH=seeds/historical

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=1209600
JWT_LEEWAY=0

STOCKBIT_BEARER=
STOCKBIT_EXODUS_BASE=https://exodus.stockbit.com
SB_TRANSACTION_TYPE=TRANSACTION_TYPE_NET
SB_MARKET_BOARD=MARKET_BOARD_REGULER
SB_INVESTOR_TYPE=INVESTOR_TYPE_ALL
SB_LIMIT=25
SB_HISTORICAL_PERIOD=HS_PERIOD_DAILY
# SB_HISTORICAL_LIMIT=
# SB_HISTORICAL_PAGE=
SB_SAVE_DISK=local
SB_SAVE_DIR=broker_summary
SB_WATCHLIST_ID=808507
SB_WATCHLIST_PAGE=1
SB_WATCHLIST_LIMIT=500
SB_WATCHLIST_NOCHART=1
SB_WATCHLIST_SETFINCOL=1
